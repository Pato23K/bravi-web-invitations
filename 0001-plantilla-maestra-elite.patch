diff --git a/src/app/globals.css b/src/app/globals.css
new file mode 100644
index 0000000..f293b1f
--- /dev/null
+++ b/src/app/globals.css
@@ -0,0 +1,56 @@
+@import "tailwindcss";
+
+/*
+ * Paleta base de BRAVI (marfil y champaña).
+ * Cada evento la sobreescribe desde src/config/invitation.ts (plan Esencial en adelante)
+ * mediante themeToCssVars(). Mantener estos valores iguales a DEFAULT_THEME en src/lib/theme.ts.
+ */
+:root {
+  --primary: #8c7355;
+  --accent: #c8b28a;
+  --background: #faf7f1;
+  --foreground: #3f372d;
+  --surface: #ffffff;
+  --on-primary: #ffffff;
+}
+
+/* Expone las variables como utilidades de Tailwind: bg-primary, text-accent, border-accent/40, etc. */
+@theme inline {
+  --color-primary: var(--primary);
+  --color-accent: var(--accent);
+  --color-background: var(--background);
+  --color-foreground: var(--foreground);
+  --color-surface: var(--surface);
+  --color-on-primary: var(--on-primary);
+
+  --font-serif: var(--font-cormorant), "Cormorant Garamond", Georgia, serif;
+  --font-script: var(--font-pinyon), "Pinyon Script", cursive;
+}
+
+html {
+  scroll-behavior: smooth;
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  background: var(--background);
+  color: var(--foreground);
+  font-family: var(--font-serif);
+  -webkit-font-smoothing: antialiased;
+  -webkit-tap-highlight-color: transparent;
+  overflow-x: hidden;
+}
+
+/* Oculta la barra de scroll en carruseles horizontales sin perder el desplazamiento. */
+@utility no-scrollbar {
+  scrollbar-width: none;
+  &::-webkit-scrollbar {
+    display: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+}
diff --git a/src/app/layout.tsx b/src/app/layout.tsx
new file mode 100644
index 0000000..22b0386
--- /dev/null
+++ b/src/app/layout.tsx
@@ -0,0 +1,41 @@
+import type { Metadata, Viewport } from "next";
+import { Cormorant_Garamond, Pinyon_Script } from "next/font/google";
+import type { ReactNode } from "react";
+import { invitation } from "@/config/invitation";
+import "./globals.css";
+
+const cormorant = Cormorant_Garamond({
+  subsets: ["latin"],
+  weight: ["300", "400", "500", "600"],
+  style: ["normal", "italic"],
+  variable: "--font-cormorant",
+  display: "swap",
+});
+
+const pinyon = Pinyon_Script({
+  subsets: ["latin"],
+  weight: "400",
+  variable: "--font-pinyon",
+  display: "swap",
+});
+
+const hostsLabel = invitation.event.hosts.join(" & ");
+
+export const metadata: Metadata = {
+  title: `${hostsLabel} · ${invitation.event.type}`,
+  description: invitation.event.welcomeMessage ?? `Invitación de ${hostsLabel}`,
+};
+
+export const viewport: Viewport = {
+  width: "device-width",
+  initialScale: 1,
+  themeColor: invitation.theme.background,
+};
+
+export default function RootLayout({ children }: { children: ReactNode }) {
+  return (
+    <html lang="es-MX" className={`${cormorant.variable} ${pinyon.variable}`}>
+      <body>{children}</body>
+    </html>
+  );
+}
