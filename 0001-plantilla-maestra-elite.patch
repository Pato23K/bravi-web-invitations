index 0000000..54c1040
--- /dev/null
+++ b/src/app/page.tsx
@@ -0,0 +1,29 @@
+import { InvitationTemplate } from "@/components/InvitationTemplate";
+import { PlanSwitcher } from "@/components/common/PlanSwitcher";
+import { invitation } from "@/config/invitation";
+import { resolveDemoOverrides } from "@/lib/demo";
+
+interface PageProps {
+  searchParams: Promise<Record<string, string | string[] | undefined>>;
+}
+
+/**
+ * Vista principal. El plan sale de src/config/invitation.ts.
+ * En modo demo (npm run dev) se puede alternar con:
+ *   /?plan=express   /?plan=esencial   /?plan=signature   /?plan=elite
+ * y agregar &preview=1 para ver con candado los apartados fuera del plan.
+ */
+export default async function Page({ searchParams }: PageProps) {
+  const params = await searchParams;
+  const { plan, preview, demo } = resolveDemoOverrides(params, invitation.plan);
+
+  return (
+    <>
+      {demo && <PlanSwitcher currentPlan={plan} preview={preview} />}
+      <InvitationTemplate
+        config={invitation}
+        planContext={{ plan, preview, hiddenSections: invitation.hiddenSections ?? [] }}
+      />
+    </>
+  );
+}
diff --git a/src/components/InvitationTemplate.tsx b/src/components/InvitationTemplate.tsx
new file mode 100644
index 0000000..df734c4
--- /dev/null
+++ b/src/components/InvitationTemplate.tsx
@@ -0,0 +1,107 @@
+import { CoverIntro } from "@/components/common/CoverIntro";
+import { PlanGate } from "@/components/common/PlanGate";
+import { AccommodationCards } from "@/components/elite/AccommodationCards";
+import { EventItineraryTimeline } from "@/components/elite/EventItineraryTimeline";
+import { BasicGiftRegistry } from "@/components/esencial/BasicGiftRegistry";
+import { LocationMaps } from "@/components/esencial/LocationMaps";
+import { EventCountdown } from "@/components/express/EventCountdown";
+import { HeroVideo } from "@/components/express/HeroVideo";
+import { RsvpButton } from "@/components/express/RsvpButton";
+import { DressCode } from "@/components/signature/DressCode";
+import { GlobalAudioPlayer } from "@/components/signature/GlobalAudioPlayer";
+import { PhotoGallery } from "@/components/signature/PhotoGallery";
+import { getFeatureAccess, type PlanContext } from "@/config/plans";
+import { formatEventDate } from "@/lib/date";
+import { DEFAULT_THEME, themeToCssVars } from "@/lib/theme";
+import type { InvitationConfig } from "@/types/invitation";
+
+export interface InvitationTemplateProps {
+  config: InvitationConfig;
+  planContext: PlanContext;
+}
+
+/**
+ * Plantilla Maestra BRAVI: contiene todos los apartados (plan Elite) y cada uno
+ * se activa o bloquea con <PlanGate> según el plan. El orden de las secciones
+ * se cambia aquí.
+ */
+export function InvitationTemplate({ config, planContext }: InvitationTemplateProps) {
+  const { event } = config;
+  const dates = formatEventDate(event.date, event.timeZone);
+
+  // La paleta personalizada es del plan Esencial en adelante.
+  const theme = getFeatureAccess(planContext, "customTheme") === "enabled" ? config.theme : DEFAULT_THEME;
+  const smartCopy = getFeatureAccess(planContext, "smartCopyClabe") === "enabled";
+
+  return (
+    <div style={themeToCssVars(theme)} className="bg-background text-foreground">
+      <main className="relative mx-auto min-h-screen w-full max-w-md overflow-x-clip bg-background shadow-[0_0_60px_-20px_rgba(0,0,0,0.25)]">
+        <CoverIntro hosts={event.hosts} eventType={event.type} shortDate={dates.shortDate} />
+
+        {/* ---------- Fase 1 · Express ---------- */}
+        <PlanGate feature="hero" planContext={planContext}>
+          <HeroVideo
+            videoSrc={config.hero.videoSrc}
+            posterSrc={config.hero.posterSrc}
+            eyebrow={config.hero.eyebrow}
+            hosts={event.hosts}
+            shortDate={dates.shortDate}
+          />
+        </PlanGate>
+
+        <PlanGate feature="countdown" planContext={planContext}>
+          <EventCountdown
+            targetDate={event.date}
+            fullDate={dates.fullDate}
+            time={dates.time}
+            message={event.welcomeMessage}
+          />
+        </PlanGate>
+
+        {/* ---------- Fase 3 · Signature ---------- */}
+        <PlanGate feature="gallery" planContext={planContext}>
+          <PhotoGallery photos={config.gallery} />
+        </PlanGate>
+
+        {/* ---------- Fase 2 · Esencial ---------- */}
+        <PlanGate feature="location" planContext={planContext}>
+          <LocationMaps venues={config.locations} />
+        </PlanGate>
+
+        {/* ---------- Fase 4 · Elite ---------- */}
+        <PlanGate feature="itinerary" planContext={planContext}>
+          <EventItineraryTimeline items={config.itinerary} />
+        </PlanGate>
+
+        {/* ---------- Fase 3 · Signature ---------- */}
+        <PlanGate feature="dressCode" planContext={planContext}>
+          <DressCode {...config.dressCode} />
+        </PlanGate>
+
+        {/* ---------- Fase 2 · Esencial (+ copiado inteligente en Signature) ---------- */}
+        <PlanGate feature="giftRegistry" planContext={planContext}>
+          <BasicGiftRegistry {...config.giftRegistry} smartCopy={smartCopy} />
+        </PlanGate>
+
+        {/* ---------- Fase 4 · Elite ---------- */}
+        <PlanGate feature="accommodations" planContext={planContext}>
+          <AccommodationCards hotels={config.accommodations} />
+        </PlanGate>
+
+        {/* ---------- Fase 1 · Express ---------- */}
+        <PlanGate feature="rsvp" planContext={planContext}>
+          <RsvpButton {...config.rsvp} />
+        </PlanGate>
+
+        <footer className="px-6 pb-24 pt-8 text-center text-xs uppercase tracking-[0.35em] text-foreground/45">
+          Hecho con BRAVI
+        </footer>
+
+        {/* ---------- Fase 3 · Signature (botón flotante) ---------- */}
+        <PlanGate feature="audio" planContext={planContext} previewContent={false}>
+          <GlobalAudioPlayer src={config.audio.src} title={config.audio.title} />
+        </PlanGate>
+      </main>
+    </div>
+  );
+}
diff --git a/src/components/common/CoverIntro.tsx b/src/components/common/CoverIntro.tsx
new file mode 100644
index 0000000..0467a9a
--- /dev/null
+++ b/src/components/common/CoverIntro.tsx
@@ -0,0 +1,89 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { INVITATION_OPEN_EVENT } from "@/lib/events";
+import { Ornament } from "./SectionHeading";
+
+interface CoverIntroProps {
+  hosts: string[];
+  eventType: string;
+  shortDate: string;
+}
+
+type CoverState = "closed" | "opening" | "gone";
+
+const OPEN_DURATION_MS = 1200;
+
+/**
+ * Portada "Abrir invitación". Al tocarla:
+ * 1. Dispara INVITATION_OPEN_EVENT dentro del mismo gesto del usuario, así el
+ *    reproductor de audio (plan Signature+) puede iniciar la música sin bloqueo.
+ * 2. Abre dos paneles tipo cortina y desaparece.
+ */
+export function CoverIntro({ hosts, eventType, shortDate }: CoverIntroProps) {
+  const [state, setState] = useState<CoverState>("closed");
+  const initials = hosts.map((name) => name.charAt(0).toUpperCase());
+
+  // Bloquea el scroll mientras la portada está visible.
+  useEffect(() => {
+    if (state === "gone") return;
+    const previous = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+    return () => {
+      document.body.style.overflow = previous;
+    };
+  }, [state]);
+
+  useEffect(() => {
+    if (state !== "opening") return;
+    const timer = window.setTimeout(() => setState("gone"), OPEN_DURATION_MS);
+    return () => window.clearTimeout(timer);
+  }, [state]);
+
+  if (state === "gone") return null;
+
+  const handleOpen = () => {
+    if (state !== "closed") return;
+    window.dispatchEvent(new Event(INVITATION_OPEN_EVENT));
+    setState("opening");
+  };
+
+  const isOpening = state === "opening";
+  const panelBase =
+    "absolute inset-y-0 w-1/2 bg-background transition-transform duration-[1200ms] ease-[cubic-bezier(.7,0,.3,1)] motion-reduce:transition-none";
+
+  return (
+    <div className="fixed inset-0 z-50" aria-hidden={isOpening}>
+      {/* Paneles tipo cortina */}
+      <div className={`${panelBase} left-0 ${isOpening ? "-translate-x-full shadow-2xl" : ""}`} />
+      <div className={`${panelBase} right-0 ${isOpening ? "translate-x-full shadow-2xl" : ""}`} />
+
+      <div
+        className={`relative flex h-full flex-col items-center justify-center px-8 text-center transition-opacity duration-500 ${
+          isOpening ? "opacity-0" : "opacity-100"
+        }`}
+      >
+        <p className="text-[11px] uppercase tracking-[0.35em] text-foreground/60">{eventType}</p>
+
+        <button
+          type="button"
+          onClick={handleOpen}
+          className="group my-8 flex h-36 w-36 items-center justify-center rounded-full border border-accent bg-surface shadow-[0_10px_40px_-12px_rgba(0,0,0,0.25)] transition-transform active:scale-95"
+          aria-label="Abrir invitación"
+        >
+          <span className="flex h-28 w-28 items-center justify-center rounded-full border border-accent/50 font-script text-4xl text-primary">
+            {initials.join("&")}
+          </span>
+        </button>
+
+        <h1 className="font-script text-5xl leading-tight text-primary">{hosts.join(" & ")}</h1>
+        <Ornament className="mx-auto my-4 text-accent" />
+        <p className="text-sm tracking-[0.3em] text-foreground/70">{shortDate}</p>
+
+        <p className="mt-10 animate-pulse text-xs uppercase tracking-[0.3em] text-foreground/60">
+          Toca para abrir
+        </p>
+      </div>
+    </div>
+  );
+}
