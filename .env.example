# Modo demo: permite cambiar de plan con ?plan=express|esencial|signature|elite
# y ver los apartados bloqueados con ?preview=1.
# En `npm run dev` está activo siempre. En producción solo si vale "true".
# Déjalo vacío o en "false" en las invitaciones reales de los clientes.
BRAVI_DEMO_MODE=false

# URL base del sitio en producción para Open Graph y previsualizaciones en WhatsApp / iMessage.
# En Vercel se autodetecta mediante VERCEL_PROJECT_PRODUCTION_URL si no se define.
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
